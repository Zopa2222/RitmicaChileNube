APP_ENV=development
DATABASE_URL=postgresql+psycopg://ritmica:ritmica_local@localhost:5432/ritmica_chile
MONGODB_URI=mongodb://localhost:27017/
FLASK_PORT=8080
FLASK_DEBUG=False
CORS_ORIGINS=http://localhost:4200
ENABLE_LEGACY_ROUTES=True
JWT_SECRET_KEY=replace-with-a-long-random-secret
RATELIMIT_STORAGE_URI=memory://
FILE_STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=
GCS_BUCKET=
IMPORT_PREVIEW_TTL_HOURS=24

# Initial fixed accounts. Supply these as secrets when running
# `flask --app run.py bootstrap-fixed-users`.
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=
GLOBAL_ADMIN_USERNAME=
GLOBAL_ADMIN_PASSWORD=

# Cloud Run provides PORT automatically.
WEB_CONCURRENCY=2
WEB_THREADS=4
WEB_TIMEOUT=120
